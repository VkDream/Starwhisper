{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "星伴｜手机动作、QQ会话与音频所有权",
    "locale": "zh-CN",
    "output": "phone-audio.html",
    "quality_profile": "showcase",
    "animation": "none"
  },
  "lanes": [
    {
      "id": "command",
      "label": "用户明确动作"
    },
    {
      "id": "qq",
      "label": "QQ会话执行"
    },
    {
      "id": "lifecycle",
      "label": "星伴媒体与生命周期"
    }
  ],
  "mainPath": [
    "input",
    "parse",
    "persist",
    "gate",
    "scope",
    "execute",
    "result"
  ],
  "nodes": [
    {
      "id": "input",
      "lane": "command",
      "col": 0,
      "type": "frontend",
      "label": "当前整句命令",
      "sublabel": "或用户点击音量控制"
    },
    {
      "id": "parse",
      "lane": "command",
      "col": 1,
      "type": "backend",
      "label": "识别受支持动作",
      "sublabel": "整句解析 / UI明确动作"
    },
    {
      "id": "persist",
      "lane": "command",
      "col": 2,
      "type": "database",
      "label": "先保存本地回应",
      "sublabel": "移交用将来时，写失败不执行"
    },
    {
      "id": "handoff",
      "lane": "command",
      "col": 3,
      "type": "external",
      "label": "系统应用移交",
      "sublabel": "打开QQ / 设置闹钟请求"
    },
    {
      "id": "gate",
      "lane": "qq",
      "col": 2,
      "type": "security",
      "label": "QQ会话权限门",
      "sublabel": "安装 + 通知访问 + 活跃会话"
    },
    {
      "id": "scope",
      "lane": "qq",
      "col": 3,
      "type": "security",
      "label": "action / scope复核",
      "sublabel": "音量范围须与捕获时一致"
    },
    {
      "id": "execute",
      "lane": "qq",
      "col": 4,
      "type": "external",
      "label": "提交平台请求",
      "sublabel": "MediaController / 音量目标"
    },
    {
      "id": "result",
      "lane": "qq",
      "col": 5,
      "type": "database",
      "label": "保存真实返回",
      "sublabel": "不等于歌曲已播 / 闹钟已建"
    },
    {
      "id": "foreground",
      "lane": "lifecycle",
      "col": 0,
      "type": "frontend",
      "label": "Activity可见性",
      "sublabel": "onStart / onStop"
    },
    {
      "id": "speech",
      "lane": "lifecycle",
      "col": 1,
      "type": "backend",
      "label": "SpeechRuntime",
      "sublabel": "ASR、TTS、本地音乐与焦点"
    },
    {
      "id": "source",
      "lane": "lifecycle",
      "col": 2,
      "type": "backend",
      "label": "音乐来源local / qq",
      "sublabel": "qq时释放星伴本地播放器"
    },
    {
      "id": "background",
      "lane": "lifecycle",
      "col": 3,
      "type": "backend",
      "label": "后台取消与解绑",
      "sublabel": "星伴停播；QQ仅停止观察"
    }
  ],
  "edges": [
    {
