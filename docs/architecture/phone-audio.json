      "to": "result",
      "label": "系统返回",
      "role": "branch"
    },
    {
      "id": "foreground-to-speech",
      "from": "foreground",
      "to": "speech",
      "role": "branch"
    },
    {
      "id": "speech-to-source",
      "from": "speech",
      "to": "source",
      "role": "branch"
    },
    {
      "id": "foreground-to-background",
      "from": "foreground",
      "to": "background",
      "label": "onStop",
      "role": "branch"
    },
    {
      "id": "background-to-gate",
      "from": "background",
      "to": "gate",
      "label": "解除QQ观察",
      "role": "branch"
    }
