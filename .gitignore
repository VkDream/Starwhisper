# Public repository allowlist. Everything else stays local.
/*
!/.gitignore
!/README.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties

!/app/
/app/*
!/app/build.gradle.kts
!/app/src/
!/app/src/**

!/core/
/core/*
!/core/build.gradle.kts
!/core/src/
!/core/src/**

!/scripts/
/scripts/*
!/scripts/Build.ps1

!/assets/
/assets/*
!/assets/audio/
/assets/audio/*
!/assets/audio/ATTRIBUTION.md
!/assets/audio/music-sources.json

!/docs/
/docs/*
!/docs/ARCHITECTURE.md
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/index.html
!/docs/architecture/maintenance.md
!/docs/architecture/candidate.json
!/docs/architecture/xingban-architecture.html
!/docs/architecture/xingban-architecture.svg
!/docs/architecture/xingban-architecture.png
!/docs/architecture/chat-turn.json
!/docs/architecture/chat-turn.html
!/docs/architecture/chat-turn.svg
!/docs/architecture/chat-turn.png
!/docs/architecture/read-only-tools.json
!/docs/architecture/read-only-tools.html
!/docs/architecture/read-only-tools.svg
!/docs/architecture/read-only-tools.png
!/docs/architecture/phone-audio.json
!/docs/architecture/phone-audio.html
!/docs/architecture/phone-audio.svg
!/docs/architecture/phone-audio.png
!/docs/architecture/storage-memory.json
!/docs/architecture/storage-memory.html
!/docs/architecture/storage-memory.svg
!/docs/architecture/storage-memory.png

# Generated files, local settings, credentials, packages and private data.
**/build/
**/.gradle/
**/.kotlin/
**/.idea/
**/local.properties
**/.env
**/.env.*
**/keystore.properties
**/signing.properties
**/secrets.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.apk
**/*.aab
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/private-exports/
**/private_exports/
**/exports/
**/backups/
